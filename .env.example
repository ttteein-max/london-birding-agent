# Optional local live-model configuration. Copy to .env and fill in your own
# key and accessible model ID. Start the backend from the repository root with:
# python -m uvicorn app.biodiversity.api.main:app --env-file .env --host 127.0.0.1 --port 8000
# The application reads environment variables; .env is not loaded without an
# explicit loader such as --env-file. Existing shell variables take precedence.
# Keys stay backend-only. Live calls use the configured key's API project;
# fixture/scripted makes no model API calls. Compose permits only fixture/scripted
# and does not forward this file's credentials into the demo container.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Routing keys remain backend-only. Never use a VITE_ prefix.
ORS_API_KEY=
GRAPHHOPPER_API_KEY=
# Optional higher-quota TfL Journey Planner key. Live multimodal routing can use
# TfL's anonymous allowance, but production deployments should configure one.
TFL_API_KEY=

# Keyless HTTPS MapLibre style. Set to "disabled" for the overlay-only fallback.
# Credential-bearing query parameters are rejected by configuration validation.
BIODIVERSITY_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# For a custom style, list any additional HTTPS sprite, glyph and tile origins.
# The style URL's own origin is added automatically. CSP fragments are rejected.
BIODIVERSITY_BASEMAP_RESOURCE_ORIGINS=https://tiles.openfreemap.org,https://*.openfreemap.org,https://*.tile.openstreetmap.org

# Local development exposes all four run modes by default. This line is only
# needed if you want to override that allowlist explicitly.
BIODIVERSITY_ALLOWED_RUN_MODES=fixture/scripted,live/scripted,fixture/live,live/live
