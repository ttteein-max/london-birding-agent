  "theme": "base",
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 28,
    "rankSpacing": 42
  },
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "lineColor": "#64748b",
    "primaryTextColor": "#172033"
